{# templates/user/login.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
<div id="home" class="hero-area">
    <div class="bg-image bg-parallax overlay"
         style="background-image:url({{ asset('user/img/home-background.jpg') }})"></div>

    <div class="container">
        <div class="row">

            <!-- Spacer to push content below header -->
            <div class="col-md-12" style="height:180px;"></div>

            <div class="col-md-4 col-md-offset-4">
                <div class="panel panel-default">
                    <div class="panel-heading text-center">
                        <h3>Welcome Back!</h3>
                        <p style="font-size: 12px; margin: 5px 0 0 0;">Login to continue your learning journey</p>
                    </div>

                    <div class="panel-body">

                        {% if error %}
                            <div class="alert alert-danger">
                                <i class="fa fa-exclamation-circle"></i> {{ error.messageKey|trans(error.messageData, 'security') }}
                            </div>
                        {% endif %}

                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success">
                                <i class="fa fa-check-circle"></i> {{ message }}
                            </div>
                        {% endfor %}

                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger">
                                <i class="fa fa-exclamation-circle"></i> {{ message }}
                            </div>
                        {% endfor %}

                        <a href="{{ path('connect_google_start') }}" class="main-button btn-block" style="display: flex; align-items: center; justify-content: center; gap: 8px;">
                            <svg style="width: 18px; height: 18px;" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                            </svg>
                            Continue with Google
                        </a>

                        <div style="text-align: center; margin: 20px 0; position: relative;">
                            <hr>
                            <span style="position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: white; padding: 0 8px; color: #6c757d; font-size: 13px;">OR</span>
                        </div>
                        
                        <form method="post" action="{{ path('app_login') }}">
                            <div class="form-group">
                                <label for="inputEmail">
                                    <i class="fa fa-envelope"></i> Email
                                </label>
                                <input type="email" 
                                       value="{{ last_username }}" 
                                       name="email" 
                                       id="inputEmail" 
                                       class="form-control" 
                                       placeholder="your.email@example.com"
                                       autocomplete="email" 
                                       required 
                                       autofocus>
                            </div>

                            <div class="form-group">
                                <label for="inputPassword">
                                    <i class="fa fa-lock"></i> Password
                                </label>
                                <input type="password" 
                                       name="password" 
                                       id="inputPassword" 
                                       class="form-control" 
                                       placeholder="Enter your password"
                                       autocomplete="current-password" 
                                       required>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="form-check" style="margin-bottom: 15px;">
                                <input class="form-check-input" 
                                       type="checkbox" 
                                       name="_remember_me" 
                                       id="remember_me">
                                <label class="form-check-label" for="remember_me">
                                    Remember me
                                </label>
                                <a href="{{ path('app_forgot_password') }}" style="float: right; font-size: 12px;">
                                    Forgot password?
                                </a>
                            </div>

                            <button class="main-button btn-block" type="submit">
                                <i class="fa fa-sign-in-alt"></i> Sign in
                            </button>
                        </form>

                        <hr>
                        <p class="text-center">
                            Don't have an account?
                            <a href="{{ path('app_signup') }}">Sign up here</a>
                        </p>

                    </div>
                </div>
            </div>

            <!-- Bottom spacer -->
            <div class="col-md-12" style="height:120px;"></div>

        </div>
    </div>
</div>
{% endblock %}