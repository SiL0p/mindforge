{% extends 'base.html.twig' %}

{% block title %}Edit Profile{% endblock %}

{% block body %}
<!-- Header -->
<header id="header">
    <div class="container">
        <div class="navbar-header">
            <!-- Logo -->
            <div class="navbar-brand">
                <a class="logo" href="{{ path('app_home') }}">
                    <img src="{{ asset('user/img/logo.png') }}" alt="logo">
                </a>
            </div>
            <!-- /Logo -->
        </div>

        <!-- Navigation -->
        <nav id="nav">
            <ul class="main-menu nav navbar-nav navbar-right">
                <li><a href="{{ path('app_home') }}">Home</a></li>
                <li><a href="{{ path('app_contact') }}">Contact</a></li>
                <li><a href="{{ path('app_home') }}">Home</a></li>
        <li><a href="{{ path('app_profile_view') }}">
            <i class="fa fa-arrow-left"></i> Back to Profile
        </a></li>
            </ul>
        </nav>
        <!-- /Navigation -->
    </div>
</header>
<!-- /Header -->

<!-- Hero-area -->
<div class="hero-area section">
    <div class="bg-image bg-parallax overlay" style="background-image:url({{ asset('user/img/blog-post-background.jpg') }})"></div>
    <div class="container">
        <div class="row">
            <div class="col-md-8 col-md-offset-2 text-center">
                <h1 class="white-text">Edit Your Profile</h1>
                <p class="white-text">Update your bio and avatar</p>
            </div>
        </div>
    </div>
</div>
<!-- /Hero-area -->

<!-- Form Section -->
<div class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <div class="blog-post" style="padding: 30px; background: #fff; border-radius: 10px; box-shadow: 0 0 20px rgba(0,0,0,0.1);">

                    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

                        <div class="form-group text-center">
                            {% if profile.avatar %}
                                <img id="avatarPreview" src="{{ asset('uploads/avatars/' ~ profile.avatar) }}" alt="Avatar" class="img-circle" style="width:120px; height:120px; object-fit:cover; margin-bottom:15px;">
                            {% else %}
                                <img id="avatarPreview" src="{{ asset('user/img/avatar.png') }}" alt="Avatar" class="img-circle" style="width:120px; height:120px; object-fit:cover; margin-bottom:15px;">
                            {% endif %}
                        </div>

                        <div class="form-group">
                            <button type="button" id="generateAvatarBtn" class="btn btn-info btn-block" style="margin-bottom: 10px; background: #17a2b8; color: white; padding: 10px; border: none; border-radius: 4px; cursor: pointer;">
                                <i class="fa fa-magic"></i> Generate Avatar
                            </button>
                        </div>
                        <div class="form-group">
    <a href="{{ path('app_avatar_builder') }}" class="btn btn-block" style="background: #e8572a; color: white; padding: 10px; border-radius: 4px; display:block; text-align:center;">
        <i class="fa fa-magic"></i> Customize My Avatar
    </a>
</div>
                        <div class="form-group">
                            {{ form_label(form.avatarFile, 'Or Upload Custom Avatar') }}
                            {{ form_widget(form.avatarFile, {'attr': {'class': 'form-control-file'}}) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.bio, 'Bio') }}
                            {{ form_widget(form.bio, {'attr': {'class': 'form-control', 'rows': 5, 'placeholder': 'Tell us about yourself...'}}) }}
                        </div>

                        <div class="text-center">
                            <button type="submit" class="main-button icon-button">Save Changes</button>
                        </div>

                    {{ form_end(form) }}

                </div>
            </div>
        </div>
    </div>
</div>
<!-- /Form Section -->

<!-- Footer -->
<footer id="footer" class="section">
    <div class="container text-center">
        <div class="footer-logo">
            <a class="logo" href="{{ path('app_home') }}">
                <img src="{{ asset('user/img/logo.png') }}" alt="logo">
            </a>
        </div>
        <p>&copy; 2026 All Rights Reserved</p>
    </div>
</footer>
<!-- /Footer -->

<script>
document.addEventListener('DOMContentLoaded', function() {
    const generateBtn = document.getElementById('generateAvatarBtn');
    const avatarPreview = document.getElementById('avatarPreview');

    if (generateBtn) {
        generateBtn.addEventListener('click', function(e) {
            e.preventDefault();
            
            // Show loading state
            const originalText = generateBtn.innerHTML;
            generateBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Generating...';
            generateBtn.disabled = true;

            // Make AJAX request to generate avatar
            fetch('{{ path('app_generate_avatar') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update avatar preview
                    avatarPreview.src = data.avatar + '?t=' + new Date().getTime();
                    
                    // Show success message
                    const alertDiv = document.createElement('div');
                    alertDiv.className = 'alert alert-success';
                    alertDiv.style.marginBottom = '15px';
                    alertDiv.innerHTML = '<i class="fa fa-check-circle"></i> ' + data.message;
                    generateBtn.parentElement.insertBefore(alertDiv, generateBtn);
                    
                    // Remove message after 3 seconds
                    setTimeout(() => alertDiv.remove(), 3000);
                } else {
                    alert('Error: ' + (data.error || 'Failed to generate avatar'));
                }
            })
            .catch(error => {
                alert('Error generating avatar: ' + error.message);
            })
            .finally(() => {
                // Restore button state
                generateBtn.innerHTML = originalText;
                generateBtn.disabled = false;
            });
        });
    }
});
</script>
{% endblock %}
