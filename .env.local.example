# COPY THIS FILE TO .env.local AND FILL IN YOUR CREDENTIALS
# This file should NEVER be committed to Git

###> Community Module - Shared Tasks (Challenges) ###

# OpenAI API Key (required for AI features)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Mailer Configuration (for email notifications)
# Option 1 - SendGrid (Production)
# MAILER_DSN=sendgrid+api://SG.your-api-key@default

# Option 2 - Console/File (Development - no email needed)
MAILER_DSN=null://null

# Email sender address
MAILER_FROM=noreply@mindforge.com

