{% extends 'workspace/module_base.html.twig' %}

{% block title %}Sent Challenges{% endblock %}

{% block module_title %}Sent Challenges{% endblock %}
{% block module_subtitle %}Track challenges you shared with others.{% endblock %}
{% block module_content %}
<div class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="page-header">
                    <h2><i class="fa fa-send"></i> Sent Challenges</h2>
                </div>

                <div class="btn-group" style="margin-bottom: 20px;">
                    <a href="{{ path('community_challenge_outbox') }}" class="btn btn-default {% if not filterStatus %}active{% endif %}">All</a>
                    <a href="{{ path('community_challenge_outbox', {status: 'pending'}) }}" class="btn btn-default {% if filterStatus == 'pending' %}active{% endif %}">Pending</a>
                    <a href="{{ path('community_challenge_outbox', {status: 'accepted'}) }}" class="btn btn-default {% if filterStatus == 'accepted' %}active{% endif %}">Accepted</a>
                    <a href="{{ path('community_challenge_outbox', {status: 'rejected'}) }}" class="btn btn-default {% if filterStatus == 'rejected' %}active{% endif %}">Rejected</a>
                </div>

                {% if tasks is empty %}
                    <div class="alert alert-info">No challenges found.</div>
                {% else %}
                    {% for task in tasks %}
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <strong>{{ task.title }}</strong>
                                <span class="label {% if task.status == 'pending' %}label-warning{% elseif task.status == 'accepted' %}label-success{% elseif task.status == 'rejected' %}label-danger{% else %}label-default{% endif %}" style="margin-left: 8px;">{{ task.status|upper }}</span>
                            </div>
                            <div class="panel-body">
                                <p><strong>To:</strong> {{ task.sharedWith.userIdentifier }}</p>
                                
                                <div style="margin: 10px 0;">
                                    {% if task.category %}
                                        <span class="label" style="background-color: #E3F2FD; color: #1976D2; padding: 5px 8px; border-radius: 3px; margin-right: 8px;">
                                            📁 {{ task.category|replace({'_': ' '})|title }}
                                        </span>
                                    {% endif %}
                                    {% if task.difficulty %}
                                        <span class="label" style="background-color: #FFF3E0; color: #F57C00; padding: 5px 8px; border-radius: 3px;">
                                            {% if task.difficulty == 'easy' %}🟢 Facile
                                            {% elseif task.difficulty == 'medium' %}🟡 Moyen
                                            {% elseif task.difficulty == 'hard' %}🔴 Difficile
                                            {% endif %}
                                        </span>
                                    {% endif %}
                                </div>

                                {% if task.description %}
                                    <p style="white-space: pre-wrap;">{{ task.description }}</p>
                                {% endif %}

                                {% if task.attachment %}
                                    <div style="margin: 15px 0; padding: 10px; background: #f5f5f5; border-radius: 4px;">
                                        <strong>📎 Pièce jointe :</strong><br>
                                        {% set fileUrl = vich_uploader_asset(task, 'attachmentFile') %}
                                        {% if fileUrl %}
                                            {% set extension = task.attachment|split('.')|last|lower %}
                                            {% if extension in ['jpg', 'jpeg', 'png', 'gif', 'webp'] %}
                                                <img src="{{ fileUrl }}" alt="{{ task.attachment }}" style="max-width: 100%; max-height: 400px; border-radius: 4px; margin-top: 8px;">
                                            {% else %}
                                                <a href="{{ fileUrl }}" target="_blank" class="btn btn-xs btn-default" style="margin-top: 8px;">
                                                    <i class="fa fa-download"></i> {{ task.attachment }}
                                                </a>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                {% endif %}

                                <p class="text-muted">
                                    <small>📅 Sent: {{ task.createdAt|date('d/m/Y H:i') }}
                                    {% if task.respondedAt %}| Responded: {{ task.respondedAt|date('d/m/Y H:i') }}{% endif %}</small>
                                </p>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}

                <a href="{{ path('community_challenge_send') }}" class="btn btn-primary">Send Challenge</a>
                <a href="{{ path('community_challenge_inbox') }}" class="btn btn-default">Received Challenges</a>
                <a href="{{ path('community_tasks') }}" class="btn btn-default">Tasks</a>
                <a href="{{ path('community_index') }}" class="btn btn-link">Back to Community</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
