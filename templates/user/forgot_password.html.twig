{% extends 'base.html.twig' %}

{% block title %}Forgot Password{% endblock %}

{% block body %}
<div id="home" class="hero-area">
    <div class="bg-image bg-parallax overlay"
         style="background-image:url({{ asset('user/img/home-background.jpg') }})"></div>

    <div class="container">
        <div class="row">

            <div class="col-md-12" style="height:180px;"></div>

            <div class="col-md-4 col-md-offset-4">
                <div class="panel panel-default">
                    <div class="panel-heading text-center">
                        <h3>Forgot Password?</h3>
                        <p style="font-size: 12px; margin: 5px 0 0 0;">Enter your email and we'll send you a reset link</p>
                    </div>

                    <div class="panel-body">

                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success">
                                <i class="fa fa-check-circle"></i> {{ message }}
                            </div>
                        {% endfor %}

                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger">
                                <i class="fa fa-exclamation-circle"></i> {{ message }}
                            </div>
                        {% endfor %}

                        <form method="post" action="{{ path('app_forgot_password') }}">
                            <div class="form-group">
                                <label for="email">
                                    <i class="fa fa-envelope"></i> Email Address
                                </label>
                                <input type="email"
                                       name="email"
                                       id="email"
                                       class="form-control"
                                       placeholder="your.email@example.com"
                                       required
                                       autofocus>
                            </div>

                            <button class="main-button btn-block" type="submit">
                                <i class="fa fa-paper-plane"></i> Send Reset Link
                            </button>
                        </form>

                        <hr>
                        <p class="text-center">
                            Remembered your password?
                            <a href="{{ path('app_login') }}">Back to Login</a>
                        </p>

                    </div>
                </div>
            </div>

            <div class="col-md-12" style="height:120px;"></div>

        </div>
    </div>
</div>
{% endblock %}