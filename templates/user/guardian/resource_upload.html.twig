{% extends 'workspace/module_base.html.twig' %}

{% block title %}Add a Resource{% endblock %}
{% block body_class %}guardian-ui{% endblock %}

{% block module_title %}Upload Resource{% endblock %}
{% block module_subtitle %}Share useful material with your community.{% endblock %}
{% block module_content %}
<div class="guardian-shell">
    <section class="guardian-hero mb-4">
        <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
            <div>
                <span class="guardian-pill"><i class="fas fa-upload"></i> Quick share</span>
                <h1 class="guardian-title">Add a Resource</h1>
                <p class="guardian-subtitle">Share the best ideas with the community.</p>
                <div class="mt-2">
                    <span class="guardian-badge" style="background: {{ external_ai_available ? 'rgba(34,197,94,0.2)' : 'rgba(245,158,11,0.2)' }}; color: {{ external_ai_available ? '#166534' : '#92400e' }};">
                        {{ external_ai_available ? 'External AI mode active' : 'Local generator mode active' }}
                    </span>
                </div>
            </div>
            <a href="{{ path('guardian_library') }}" class="btn btn-outline-dark">Back to the library</a>
        </div>
    </section>

    <div class="row">
        <div class="col-lg-8">
            <div class="guardian-panel p-4">
                {{ form_start(form) }}

                <div class="form-group mb-3">
                    {{ form_label(form.title, 'Resource title') }}
                    {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'Example: Fractions in Mathematics'}}) }}
                    {% if form.title.vars.errors|length %}
                        <div class="invalid-feedback d-block">
                            {{ form_errors(form.title) }}
                        </div>
                    {% endif %}
                </div>

                <div class="form-group mb-3">
                    {{ form_label(form.description, 'Description') }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Describe your resource...'}}) }}
                    {% if form.description.vars.errors|length %}
                        <div class="invalid-feedback d-block">
                            {{ form_errors(form.description) }}
                        </div>
                    {% endif %}
                </div>

                <div class="form-group mb-3">
                    <label for="ai-student-demand">Student demand / need</label>
                    <textarea id="ai-student-demand" class="form-control" rows="3" placeholder="Example: I need a concise explanation with practical exercises for exam prep."></textarea>
                    <small class="text-muted">Used by the generator to create resource content automatically. Only study-related educational requests are accepted.</small>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            {{ form_label(form.type, 'Resource type') }}
                            {{ form_widget(form.type, {'attr': {'class': 'form-select'}}) }}
                            {% if form.type.vars.errors|length %}
                                <div class="invalid-feedback d-block">
                                    {{ form_errors(form.type) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            {{ form_label(form.subject, 'Subject') }}
                            {{ form_widget(form.subject, {'attr': {'class': 'form-select'}}) }}
                            {% if form.subject.vars.errors|length %}
                                <div class="invalid-feedback d-block">
                                    {{ form_errors(form.subject) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="form-group mb-3">
                    {{ form_label(form.file, 'File') }}
                    <div class="form-text mb-2">Accepted format: PDF</div>
                    {{ form_widget(form.file, {'attr': {'class': 'form-control'}}) }}
                    {% if form.file.vars.errors|length %}
                        <div class="invalid-feedback d-block">
                            {{ form_errors(form.file) }}
                        </div>
                    {% endif %}
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-upload"></i> Add resource
                    </button>
                    <button type="button" id="ai-generate-btn" class="btn btn-success">
                        <i class="fas fa-wand-magic-sparkles"></i> Generate Resource
                    </button>
                    <a href="{{ path('guardian_library') }}" class="btn btn-outline-dark">Cancel</a>
                </div>

                <div id="ai-generate-status" class="text-muted small" style="margin-top: 10px;"></div>

                {{ form_end(form) }}
            </div>
        </div>
        <div class="col-lg-4 mt-4 mt-lg-0">
            <div class="guardian-panel p-4">
                <h5 class="mb-2">Quick tips</h5>
                <p class="text-muted">Clear descriptions help everyone.</p>
                <div class="d-grid gap-2 text-muted small">
                    <span>1. Add a specific title.</span>
                    <span>2. Choose a relevant subject.</span>
                    <span>3. Upload a clean PDF.</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const aiGenerateBtn = document.getElementById('ai-generate-btn');
    const aiGenerateStatus = document.getElementById('ai-generate-status');

    if (!aiGenerateBtn || !aiGenerateStatus) {
        return;
    }

    aiGenerateBtn.addEventListener('click', async function () {
        const titleInput = document.getElementById('{{ form.title.vars.id }}');
        const descriptionInput = document.getElementById('{{ form.description.vars.id }}');
        const subjectInput = document.getElementById('{{ form.subject.vars.id }}');
        const typeInput = document.getElementById('{{ form.type.vars.id }}');
        const demandInput = document.getElementById('ai-student-demand');

        const payload = {
            _token: '{{ csrf_token('guardian_ai_resource') }}',
            title_hint: titleInput ? titleInput.value : '',
            description: descriptionInput ? descriptionInput.value : '',
            subject_id: subjectInput ? subjectInput.value : '',
            type: typeInput ? typeInput.value : 'summary',
            student_demand: demandInput ? demandInput.value : ''
        };

        aiGenerateBtn.disabled = true;
        aiGenerateStatus.textContent = 'Generating resource...';

        try {
            const response = await fetch('{{ path('guardian_resource_ai_generate') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(payload)
            });

            const data = await response.json();

            if (!response.ok || !data.success) {
                aiGenerateStatus.textContent = data.message || 'Unable to generate resource.';
                aiGenerateBtn.disabled = false;
                return;
            }

            const sourceLabel = data.source === 'ai' ? 'External AI' : 'Local Generator';
            const fileLabel = data.file_name ? `File: ${data.file_name}` : 'File created';
            aiGenerateStatus.textContent = `Created: ${data.title} (${sourceLabel}) · ${fileLabel}. Redirecting to the library...`;
            window.location.href = data.redirect_url || '{{ path('guardian_library') }}';
        } catch (error) {
            aiGenerateStatus.textContent = 'Network error while generating AI resource.';
            aiGenerateBtn.disabled = false;
        }
    });
})();
</script>
{% endblock %}
