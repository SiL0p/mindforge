{% extends 'workspace/module_base.html.twig' %}

{% block title %}Guardian{% endblock %}
{% block body_class %}guardian-ui{% endblock %}

{% block module_title %}Guardian Hub{% endblock %}
{% block module_subtitle %}Choose how you want to study right now.{% endblock %}

{% block module_content %}
<div class="guardian-shell">
    <section class="guardian-hero mb-4">
        <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
            <div>
                <span class="guardian-pill"><i class="fas fa-shield-alt"></i> Guardian</span>
                <h1 class="guardian-title">What do you want to do?</h1>
                <p class="guardian-subtitle">Jump into focus, join a virtual room, or browse learning resources.</p>
            </div>
        </div>
    </section>

    <section class="guardian-panel p-4">
        <div class="row g-3">
            <div class="col-md-4">
                <a href="{{ path('guardian_focus_timer') }}" class="guardian-card p-3 h-100 text-decoration-none d-block">
                    <div class="d-flex align-items-center mb-2">
                        <div class="me-2">
                            <span class="guardian-pill"><i class="fas fa-clock"></i></span>
                        </div>
                        <h4 class="mb-0" style="color:#1f2937;">Focus Timer</h4>
                    </div>
                    <p class="text-muted mb-2">Run Pomodoro-style sessions linked to your Planner tasks and log real progress.</p>
                    <span class="text-primary small">Start a focus session →</span>
                </a>
            </div>
            <div class="col-md-4">
                <a href="{{ path('guardian_rooms') }}" class="guardian-card p-3 h-100 text-decoration-none d-block">
                    <div class="d-flex align-items-center mb-2">
                        <div class="me-2">
                            <span class="guardian-pill"><i class="fas fa-users"></i></span>
                        </div>
                        <h4 class="mb-0" style="color:#1f2937;">Virtual Rooms</h4>
                    </div>
                    <p class="text-muted mb-2">Join or create rooms to study with others on the same subject.</p>
                    <span class="text-primary small">Go to rooms →</span>
                </a>
            </div>
            <div class="col-md-4">
                <a href="{{ path('guardian_library') }}" class="guardian-card p-3 h-100 text-decoration-none d-block">
                    <div class="d-flex align-items-center mb-2">
                        <div class="me-2">
                            <span class="guardian-pill"><i class="fas fa-book-open"></i></span>
                        </div>
                        <h4 class="mb-0" style="color:#1f2937;">Resource Library</h4>
                    </div>
                    <p class="text-muted mb-2">Browse shared PDFs and AI-generated resources to support your tasks.</p>
                    <span class="text-primary small">Open library →</span>
                </a>
            </div>
        </div>
    </section>
</div>
{% endblock %}

