{% extends 'workspace/module_base.html.twig' %}

{% block title %}Focus Timer{% endblock %}
{% block body_class %}guardian-ui{% endblock %}

{% block module_title %}Focus Timer{% endblock %}
{% block module_subtitle %}Run Pomodoro sessions linked to your tasks.{% endblock %}

{% block module_content %}
<div class="guardian-shell">
    <section class="guardian-hero mb-4">
        <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
            <div>
                <span class="guardian-pill"><i class="fas fa-clock"></i> Pomodoro</span>
                <h1 class="guardian-title">Task Focus Sessions</h1>
                <p class="guardian-subtitle">Pick a task, start the timer, and save your completed focus session.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <div class="guardian-badge" style="background: rgba(72, 198, 239, 0.18); color: #1b4d6b;">Today: {{ today_sessions }} sessions</div>
                <div class="guardian-badge" style="background: rgba(124, 92, 255, 0.18); color: #3f2fbf;">This week: {{ week_focus_minutes }} min</div>
                <div class="guardian-badge" style="background: rgba(72, 198, 239, 0.18); color: #1b4d6b;">Total: {{ total_focus_minutes }} min</div>
            </div>
        </div>
    </section>

    <section class="guardian-panel p-4 mb-4">
        <div class="row g-3">
            <div class="col-md-6">
                <label for="task-select" class="form-label">Task</label>
                <select id="task-select" class="form-select">
                    <option value="">-- Select a task --</option>
                    {% for task in tasks %}
                        <option value="{{ task.id }}" data-priority="{{ task.priority ?? 2 }}" {% if selected_task_id == task.id %}selected{% endif %}>{{ task.title }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <label for="duration-input" class="form-label">Duration (auto by priority)</label>
                <div class="d-flex gap-2">
                    <input id="duration-input" type="number" class="form-control" min="1" max="240" value="25" readonly>
                    <button id="refresh-duration-btn" class="btn btn-outline-secondary" type="button" title="Refresh duration"><i class="fas fa-rotate-right"></i></button>
                </div>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <a href="{{ path('app_planner_task_new', {redirect: 'guardian_focus_timer'}) }}" class="btn btn-outline-primary w-100">Create task</a>
            </div>
        </div>

        <div class="guardian-card p-4 mt-4 text-center">
            <div id="timer-display" style="font-size: 54px; font-weight: 700; color: #3f2fbf; line-height: 1;">25:00</div>
            <p id="timer-status" class="text-muted" style="margin-top: 12px;">Ready to focus</p>
            <p id="timer-ai-reason" class="text-muted" style="min-height: 20px;"></p>
            <div id="timer-gamification" class="text-muted" style="min-height: 20px;"></div>
            <div id="timer-task-progress" class="text-muted" style="min-height: 20px;"></div>

            <div class="d-flex flex-wrap justify-content-center gap-2" style="margin-top: 16px;">
                <button id="start-btn" class="btn btn-success"><i class="fas fa-play"></i> Start</button>
                <button id="pause-btn" class="btn btn-warning"><i class="fas fa-pause"></i> Pause</button>
                <button id="reset-btn" class="btn btn-default"><i class="fas fa-undo"></i> Reset</button>
                <button id="complete-btn" class="btn btn-primary"><i class="fas fa-check"></i> Save session</button>
            </div>
            <small class="text-muted" style="display:block; margin-top: 10px;">A session is stored with task, duration, and timestamp.</small>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-lg-6">
                <div class="guardian-card p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 style="margin-top:0; margin-bottom:0;">AI Focus Tips</h5>
                        <button id="refresh-tips-btn" class="btn btn-xs btn-outline-secondary" type="button"><i class="fas fa-rotate-right"></i> Refresh</button>
                    </div>
                    <ul id="ai-tips-list" class="mb-2" style="padding-left: 18px;"></ul>
                    <div id="ai-motivation" class="text-muted small"></div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="guardian-card p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 style="margin-top:0; margin-bottom:0;">AI Daily Plan</h5>
                        <button id="refresh-plan-btn" class="btn btn-xs btn-outline-secondary" type="button"><i class="fas fa-rotate-right"></i> Refresh</button>
                    </div>
                    <ul id="ai-plan-list" class="mb-0" style="padding-left: 18px;"></ul>
                </div>
            </div>
        </div>

        <div class="guardian-card p-3 mt-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 style="margin-top:0; margin-bottom:0;">AI Weekly Review</h5>
                <button id="refresh-weekly-review-btn" class="btn btn-xs btn-outline-secondary" type="button"><i class="fas fa-rotate-right"></i> Refresh</button>
            </div>
            <p id="ai-weekly-summary" class="text-muted" style="margin-top: 8px; margin-bottom: 8px;"></p>
            <ul id="ai-weekly-wins" class="mb-2" style="padding-left: 18px;"></ul>
            <div id="ai-weekly-next-action" class="text-muted small"></div>
        </div>
    </section>

    <section class="guardian-panel p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 style="margin:0;">Top Focused Tasks</h4>
            <span class="text-muted small">By total minutes</span>
        </div>
        {% if per_task_totals is empty %}
            <p class="text-muted" style="margin:0;">No tracked task totals yet.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped" style="margin-bottom:0;">
                    <thead>
                        <tr>
                            <th>Task</th>
                            <th>Total minutes</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in per_task_totals %}
                            <tr>
                                <td>{{ row.task_title }}</td>
                                <td>{{ row.total_minutes }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    <section class="guardian-panel p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 style="margin:0;">Recent Focus Sessions</h4>
            <span class="text-muted small">Latest 12 entries</span>
        </div>

        {% if recent_sessions is empty %}
            <p class="text-muted" style="margin:0;">No focus sessions yet.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped" style="margin-bottom:0;">
                    <thead>
                        <tr>
                            <th>Task</th>
                            <th>Duration</th>
                            <th>Timestamp</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for session in recent_sessions %}
                            <tr>
                                <td>{{ session.task ? session.task.title : 'No task' }}</td>
                                <td>{{ session.duration }} min</td>
                                <td>{{ session.timestamp|date('Y-m-d H:i') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
</div>

<script>
(function () {
    const taskSelect = document.getElementById('task-select');
    const durationInput = document.getElementById('duration-input');
    const timerDisplay = document.getElementById('timer-display');
    const timerStatus = document.getElementById('timer-status');
    const timerGamification = document.getElementById('timer-gamification');
    const timerTaskProgress = document.getElementById('timer-task-progress');
    const timerAiReason = document.getElementById('timer-ai-reason');
    const aiTipsList = document.getElementById('ai-tips-list');
    const aiMotivation = document.getElementById('ai-motivation');
    const aiPlanList = document.getElementById('ai-plan-list');
    const aiWeeklySummary = document.getElementById('ai-weekly-summary');
    const aiWeeklyWins = document.getElementById('ai-weekly-wins');
    const aiWeeklyNextAction = document.getElementById('ai-weekly-next-action');

    const startBtn = document.getElementById('start-btn');
    const pauseBtn = document.getElementById('pause-btn');
    const resetBtn = document.getElementById('reset-btn');
    const completeBtn = document.getElementById('complete-btn');
    const refreshDurationBtn = document.getElementById('refresh-duration-btn');
    const refreshTipsBtn = document.getElementById('refresh-tips-btn');
    const refreshPlanBtn = document.getElementById('refresh-plan-btn');
    const refreshWeeklyReviewBtn = document.getElementById('refresh-weekly-review-btn');

    let timerId = null;
    let remainingSeconds = 25 * 60;
    let sessionStartedAt = null;
    let currentTargetDuration = 25;
    const API_RECOMMENDED_DURATION = '{{ path('guardian_focus_timer_api_recommended_duration', {taskId: '__TASK_ID__'}) }}';
    const API_TIPS = '{{ path('guardian_focus_timer_api_tips', {taskId: '__TASK_ID__'}) }}';
    const API_DAILY_PLAN = '{{ path('guardian_focus_timer_api_daily_plan') }}';
    const API_WEEKLY_REVIEW = '{{ path('guardian_focus_timer_api_weekly_review') }}';
    const API_LOG = '{{ path('guardian_focus_timer_api_log') }}';
    const API_SOCIAL_FOCUS = '{{ path('app_workspace_network_status_focus') }}';

    async function updateFocusMode(focusMode) {
        try {
            await fetch(API_SOCIAL_FOCUS, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ focus_mode: focusMode })
            });
        } catch (error) {
        }
    }

    function renderList(container, items, fallbackText) {
        container.innerHTML = '';

        if (!Array.isArray(items) || items.length === 0) {
            const li = document.createElement('li');
            li.textContent = fallbackText;
            container.appendChild(li);
            return;
        }

        items.forEach((item) => {
            const li = document.createElement('li');
            li.textContent = item;
            container.appendChild(li);
        });
    }

    function formatTime(totalSeconds) {
        const minutes = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
        const seconds = (totalSeconds % 60).toString().padStart(2, '0');
        return `${minutes}:${seconds}`;
    }

    function updateDisplay() {
        timerDisplay.textContent = formatTime(remainingSeconds);
    }

    function resetToInputDuration() {
        const minutes = Number(currentTargetDuration || 25);
        const boundedMinutes = Math.max(1, Math.min(240, minutes));
        durationInput.value = boundedMinutes;
        remainingSeconds = boundedMinutes * 60;
        updateDisplay();
    }

    async function applyDurationFromTask() {
        const selectedOption = taskSelect.options[taskSelect.selectedIndex];
        const taskId = Number(selectedOption?.value || 0);

        if (!taskId) {
            currentTargetDuration = 25;
            timerAiReason.textContent = '';
            renderList(aiTipsList, [], 'Select a task to load AI tips.');
            aiMotivation.textContent = '';
            resetToInputDuration();
            return;
        }

        try {
            const response = await fetch(API_RECOMMENDED_DURATION.replace('__TASK_ID__', String(taskId)), {
                method: 'GET',
                headers: {
                    'Accept': 'application/json'
                }
            });

            const data = await response.json();
            if (!response.ok || !data.success) {
                currentTargetDuration = 35;
                timerAiReason.textContent = 'Fallback duration applied.';
            } else {
                currentTargetDuration = Number(data.recommended_duration || 35);
                timerAiReason.textContent = data.reason ? `AI: ${data.reason}` : '';
            }
        } catch (error) {
            currentTargetDuration = 35;
            timerAiReason.textContent = 'Fallback duration applied.';
        }

        resetToInputDuration();
    }

    async function loadTipsForTask() {
        const taskId = Number(taskSelect.value);

        if (!taskId) {
            renderList(aiTipsList, [], 'Select a task to load AI tips.');
            aiMotivation.textContent = '';
            return;
        }

        try {
            const response = await fetch(API_TIPS.replace('__TASK_ID__', String(taskId)), {
                method: 'GET',
                headers: {
                    'Accept': 'application/json'
                }
            });

            const data = await response.json();
            if (!response.ok || !data.success) {
                renderList(aiTipsList, [], 'Unable to load AI tips right now.');
                aiMotivation.textContent = '';
                return;
            }

            renderList(aiTipsList, data.tips || [], 'No tips available.');
            aiMotivation.textContent = data.motivation || '';
        } catch (error) {
            renderList(aiTipsList, [], 'Unable to load AI tips right now.');
            aiMotivation.textContent = '';
        }
    }

    async function loadDailyPlan() {
        try {
            const response = await fetch(API_DAILY_PLAN, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json'
                }
            });

            const data = await response.json();
            if (!response.ok || !data.success) {
                renderList(aiPlanList, [], 'Unable to build the plan right now.');
                return;
            }

            renderList(aiPlanList, data.plan || [], 'No plan available.');
        } catch (error) {
            renderList(aiPlanList, [], 'Unable to build the plan right now.');
        }
    }

    async function loadWeeklyReview() {
        try {
            const response = await fetch(API_WEEKLY_REVIEW, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json'
                }
            });

            const data = await response.json();
            if (!response.ok || !data.success) {
                aiWeeklySummary.textContent = 'Unable to load weekly review right now.';
                renderList(aiWeeklyWins, [], 'No highlights available.');
                aiWeeklyNextAction.textContent = '';
                return;
            }

            aiWeeklySummary.textContent = data.summary || 'No summary available.';
            renderList(aiWeeklyWins, data.wins || [], 'No highlights available.');
            aiWeeklyNextAction.textContent = data.next_action ? `Next action: ${data.next_action}` : '';
        } catch (error) {
            aiWeeklySummary.textContent = 'Unable to load weekly review right now.';
            renderList(aiWeeklyWins, [], 'No highlights available.');
            aiWeeklyNextAction.textContent = '';
        }
    }

    function startTimer() {
        if (timerId) {
            return;
        }

        timerStatus.textContent = 'Focus in progress';
        updateFocusMode(true);
        if (!sessionStartedAt) {
            sessionStartedAt = new Date();
        }
        timerId = setInterval(() => {
            if (remainingSeconds > 0) {
                remainingSeconds -= 1;
                updateDisplay();
                return;
            }

            clearInterval(timerId);
            timerId = null;
            timerStatus.textContent = 'Timer complete. Save your session.';
        }, 1000);
    }

    function pauseTimer() {
        if (!timerId) {
            return;
        }

        clearInterval(timerId);
        timerId = null;
        timerStatus.textContent = 'Paused';
        updateFocusMode(false);
    }

    async function saveSession() {
        const taskId = Number(taskSelect.value);
        const configuredDuration = Number(currentTargetDuration || 0);

        if (!taskId) {
            timerStatus.textContent = 'Please select a task first.';
            return;
        }

        if (!configuredDuration || configuredDuration < 1 || configuredDuration > 240) {
            timerStatus.textContent = 'Duration must be between 1 and 240 minutes.';
            return;
        }

        const completedMinutes = Math.floor((configuredDuration * 60 - remainingSeconds) / 60);
        const durationToStore = completedMinutes > 0 ? completedMinutes : configuredDuration;
        const elapsedMinutes = sessionStartedAt ? Math.floor((Date.now() - sessionStartedAt.getTime()) / 60000) : completedMinutes;
        const trackedElapsed = elapsedMinutes > 0 ? elapsedMinutes : completedMinutes;

        if (trackedElapsed < 1) {
            timerStatus.textContent = 'At least 1 minute of focus is required before saving.';
            return;
        }

        timerStatus.textContent = 'Saving session...';

        try {
            const response = await fetch(API_LOG, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    _token: '{{ csrf_token('focus_session_log') }}',
                    task_id: taskId,
                    duration: durationToStore,
                    elapsed_minutes: trackedElapsed,
                    client_session_id: `${taskId}-${sessionStartedAt ? sessionStartedAt.getTime() : Date.now()}`
                })
            });

            const data = await response.json();
            if (!response.ok || !data.success) {
                timerStatus.textContent = data.message || 'Unable to save session.';
                return;
            }

            if (data.gamification) {
                const unlocked = data.gamification.unlocked_badges || [];
                const unlockedText = unlocked.length ? ` | New badges: ${unlocked.join(', ')}` : '';
                timerGamification.textContent = `+${data.gamification.xp_gained} XP | Streak: ${data.gamification.streak_days} day(s)${unlockedText}`;
            }

            if (data.task_progress) {
                const status = String(data.task_progress.status || '').replace('_', ' ');
                const actual = Number(data.task_progress.actual_minutes || 0);
                const estimated = Number(data.task_progress.estimated_minutes || 0);
                const changed = Boolean(data.task_progress.status_changed);
                const changeText = changed ? ' | Status updated automatically' : '';
                const estimateText = estimated > 0 ? ` / ${estimated} min` : '';
                timerTaskProgress.textContent = `Task status: ${status || 'unknown'} | Progress: ${actual}${estimateText} min${changeText}`;
            } else {
                timerTaskProgress.textContent = '';
            }

            timerStatus.textContent = 'Session saved. Reloading...';
            updateFocusMode(false);
            window.location.reload();
        } catch (error) {
            timerStatus.textContent = 'Network error while saving session.';
        }
    }

    startBtn.addEventListener('click', startTimer);
    pauseBtn.addEventListener('click', pauseTimer);
    resetBtn.addEventListener('click', () => {
        pauseTimer();
        updateFocusMode(false);
        resetToInputDuration();
        sessionStartedAt = null;
        timerStatus.textContent = 'Ready to focus';
        timerGamification.textContent = '';
        timerTaskProgress.textContent = '';
    });
    completeBtn.addEventListener('click', saveSession);
    refreshDurationBtn.addEventListener('click', () => {
        if (timerId) {
            timerStatus.textContent = 'Pause the timer before refreshing duration.';
            return;
        }

        applyDurationFromTask();
    });
    refreshTipsBtn.addEventListener('click', loadTipsForTask);
    refreshPlanBtn.addEventListener('click', loadDailyPlan);
    refreshWeeklyReviewBtn.addEventListener('click', loadWeeklyReview);
    taskSelect.addEventListener('change', () => {
        if (!timerId) {
            applyDurationFromTask();
            loadTipsForTask();
            sessionStartedAt = null;
            timerStatus.textContent = 'Ready to focus';
            timerGamification.textContent = '';
            timerTaskProgress.textContent = '';
        }
    });

    applyDurationFromTask();
    loadTipsForTask();
    loadDailyPlan();
    loadWeeklyReview();

    window.addEventListener('beforeunload', () => {
        updateFocusMode(false);
    });
})();
</script>
{% endblock %}
