{% extends 'workspace/module_base.html.twig' %}

{% block title %}Resource Library{% endblock %}
{% block body_class %}guardian-ui{% endblock %}

{% block module_title %}Guardian Library{% endblock %}
{% block module_subtitle %}Browse and manage learning resources.{% endblock %}
{% block module_content %}
<div class="guardian-shell">
    <section class="guardian-hero mb-4">
        <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3 position-relative">
            <div>
                <span class="guardian-pill"><i class="fas fa-book-open"></i> Popular resources</span>
                <h1 class="guardian-title">Resource Library</h1>
                <p class="guardian-subtitle">Browse a curated collection of shared learning resources.</p>
            </div>
            {% if can_upload %}
                <a href="{{ path('guardian_resource_upload') }}" class="btn btn-primary btn-lg">
                    <i class="fas fa-upload"></i> Add a resource
                </a>
            {% endif %}
        </div>
    </section>

    <section class="guardian-panel p-4 mb-4">
        <form method="GET" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="subject" class="form-label">Subject</label>
                <select id="subject" name="subject" class="form-select">
                    <option value="">-- All subjects --</option>
                    {% for subject in subjects %}
                        <option value="{{ subject.id }}" {% if filters.subject == subject.id %}selected{% endif %}>
                            {{ subject.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-4">
                <label for="type" class="form-label">Type</label>
                <select id="type" name="type" class="form-select">
                    <option value="">-- All types --</option>
                    <option value="pdf" {% if filters.type == 'pdf' %}selected{% endif %}>PDF</option>
                    <option value="summary" {% if filters.type == 'summary' %}selected{% endif %}>Summary</option>
                    <option value="cheat_sheet" {% if filters.type == 'cheat_sheet' %}selected{% endif %}>Cheat sheet</option>
                    <option value="exercise" {% if filters.type == 'exercise' %}selected{% endif %}>Exercises</option>
                </select>
            </div>
            <div class="col-md-4">
                <label for="search" class="form-label">Search</label>
                <input type="text" id="search" name="search" class="form-control" value="{{ filters.search }}" placeholder="Search...">
            </div>
            <div class="col-12 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-success">Filter</button>
                <a href="{{ path('guardian_library') }}" class="btn btn-outline-dark">Reset</a>
            </div>
        </form>
    </section>

    {% if resources is empty %}
        <div class="guardian-panel p-4 text-center">
            <h4 class="mb-2">No resources yet</h4>
            <p class="text-muted">Adjust your filters or upload a new contribution.</p>
        </div>
    {% else %}
        <div class="row g-3">
            {% for resource in resources %}
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="guardian-card h-100 p-3 d-flex flex-column justify-content-between" style="animation-delay: {{ loop.index0 * 60 }}ms;">
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div>
                                <h5 class="mb-1">{{ resource.title }}</h5>
                                <div class="text-muted small">{{ resource.subject.name }}</div>
                            </div>
                            <div class="d-flex flex-column align-items-end" style="gap:6px;">
                                <span class="guardian-badge" style="background: rgba(72,198,239,0.2); color: #1b4d6b;">
                                    {{ resource.type|upper }}
                                </span>
                                <span class="guardian-badge" style="background: {{ resource.aiGenerated ? 'rgba(34,197,94,0.2)' : 'rgba(148,163,184,0.2)' }}; color: {{ resource.aiGenerated ? '#166534' : '#475569' }};">
                                    {{ resource.aiGenerated ? 'AI' : 'Manual' }}
                                </span>
                            </div>
                        </div>
                        <p class="text-muted">{{ resource.description ? resource.description|slice(0, 110) ~ '…' : 'No description yet.' }}</p>
                        <div class="d-flex justify-content-between align-items-center text-muted small mb-3">
                            <span><i class="fas fa-user"></i>
                                {{ resource.uploader.profile and resource.uploader.profile.fullName
                                    ? resource.uploader.profile.fullName
                                    : resource.uploader.userIdentifier
                                }}
                            </span>
                            <span><i class="fas fa-download"></i> {{ resource.downloadCount }}</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <a href="{{ path('guardian_resource_download', {id: resource.id}) }}" class="btn btn-sm btn-primary">
                                <i class="fas fa-download"></i> Download
                            </a>
                            {% if app.user == resource.uploader or is_granted('ROLE_ADMIN') %}
                                <form method="POST" action="{{ path('guardian_resource_delete', {id: resource.id}) }}" onsubmit="return confirm('Are you sure?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_own_resource_' ~ resource.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-dark">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <section class="guardian-panel p-4 mt-2">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 style="margin:0;">External Suggestions (Open Library)</h4>
            <button id="load-external-suggestions" class="btn btn-sm btn-outline-primary" type="button">Refresh</button>
        </div>
        <p class="text-muted small" id="external-suggestions-query" style="margin-bottom: 10px;"></p>
        <div id="external-suggestions-list" class="row g-3"></div>
    </section>
    <div id="guardian-resource-popup" style="display:none; position:fixed; right:24px; bottom:24px; width:320px; max-width:80vw; z-index:1050; box-shadow:0 8px 24px rgba(0,0,0,0.2); border-radius:8px; overflow:hidden; background:#fff;">
        <div style="padding:10px 12px;">
            <div style="font-weight:700; color:#111827; margin-bottom:4px;">Resource created</div>
            <div style="font-size:13px; color:#4b5563;">Your resource has been added to the library.</div>
        </div>
    </div>
</div>

<script>
(function () {
    const endpoint = '{{ path('guardian_library_api_external_suggestions') }}';
    const refreshBtn = document.getElementById('load-external-suggestions');
    const queryLabel = document.getElementById('external-suggestions-query');
    const container = document.getElementById('external-suggestions-list');
    const searchInput = document.getElementById('search');

    function renderCards(items) {
        container.innerHTML = '';

        if (!Array.isArray(items) || items.length === 0) {
            container.innerHTML = '<div class="col-12"><p class="text-muted" style="margin:0;">No external suggestions available right now.</p></div>';
            return;
        }

        items.forEach((item) => {
            const col = document.createElement('div');
            col.className = 'col-md-6 col-lg-4 mb-3';

            const yearText = item.year ? ` (${item.year})` : '';
            col.innerHTML = `
                <div class="guardian-card p-3 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="fw-semibold mb-1">${item.title}</div>
                        <div class="text-muted small mb-2">${item.author}${yearText}</div>
                    </div>
                    <div style="margin-top:8px;">
                        <a class="btn btn-sm btn-outline-dark" href="${item.url}" target="_blank" rel="noopener noreferrer">Open source</a>
                    </div>
                </div>
            `;

            container.appendChild(col);
        });
    }

    async function loadSuggestions() {
        const query = (searchInput?.value || '').trim() || 'study skills';
        queryLabel.textContent = `Query: ${query}`;

        if (!refreshBtn) return;
        refreshBtn.disabled = true;
        const originalText = refreshBtn.textContent;
        refreshBtn.textContent = 'Refreshing...';

        // Add timestamp to bypass any intermediate caches and request a random page
        const cacheBuster = Date.now();
        const randomPage = Math.floor(Math.random() * 4) + 1; // pages 1..4
        const url = `${endpoint}?q=${encodeURIComponent(query)}&limit=6&page=${randomPage}&t=${cacheBuster}`;

        try {
            const response = await fetch(url, {
                method: 'GET',
                headers: { Accept: 'application/json' },
                cache: 'no-store'
            });

            const data = await response.json().catch(() => null);
            if (!response.ok || !data || !data.success) {
                renderCards([]);
                return;
            }

            renderCards(data.suggestions || []);
        } catch (error) {
            console.error('Failed to load external suggestions', error);
            renderCards([]);
        } finally {
            refreshBtn.disabled = false;
            refreshBtn.textContent = originalText;
        }
    }

    refreshBtn?.addEventListener('click', loadSuggestions);
    // allow pressing Enter in the search field to refresh external suggestions
    searchInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            e.preventDefault();
            loadSuggestions();
        }
    });
    loadSuggestions();

    // Lightweight popup when a resource was just created successfully
    const createdFlag = '{{ app.request.query.get('created')|default('') }}';
    const resourcePopup = document.getElementById('guardian-resource-popup');
    if (createdFlag === '1' && resourcePopup) {
        resourcePopup.style.display = 'block';
        resourcePopup.style.opacity = '0';
        resourcePopup.style.transform = 'translateY(10px)';
        setTimeout(() => {
            resourcePopup.style.transition = 'opacity 220ms ease, transform 220ms ease';
            resourcePopup.style.opacity = '1';
            resourcePopup.style.transform = 'translateY(0)';
        }, 20);
        setTimeout(() => {
            resourcePopup.style.opacity = '0';
            resourcePopup.style.transform = 'translateY(10px)';
            setTimeout(() => { resourcePopup.style.display = 'none'; }, 260);
        }, 2600);
    }
})();
</script>
{% endblock %}
