{% extends 'base.html.twig' %}
{% block body %}
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
    background: #080815;
    color: #fff;
    font-family: 'Segoe UI', sans-serif;
    min-height: 100vh;
}

.page {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto 1fr;
}

/* ── Header ── */
.top-bar {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 40px;
    border-bottom: 1px solid rgba(125,95,255,0.2);
    background: rgba(255,255,255,0.02);
    backdrop-filter: blur(10px);
}
.logo { font-size: 1.4rem; font-weight: 700; color: #a78bfa; letter-spacing: 1px; }
.logo span { color: #fff; }
.nav-btn {
    padding: 8px 20px;
    border-radius: 20px;
    border: 1px solid rgba(125,95,255,0.4);
    background: rgba(125,95,255,0.1);
    color: #a78bfa;
    cursor: pointer;
    font-size: 0.9rem;
    transition: 0.2s;
    text-decoration: none;
}
.nav-btn:hover { background: rgba(125,95,255,0.3); }

/* ── Left Panel ── */
.left-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 30px 40px;
    gap: 20px;
    border-right: 1px solid rgba(125,95,255,0.15);
}

.cam-wrapper {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    border: 2px solid rgba(125,95,255,0.5);
    box-shadow: 0 0 60px rgba(125,95,255,0.2);
    width: 420px;
    height: 300px;
    background: #0d0d1a;
}
.cam-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: rgba(167,139,250,0.4);
    font-size: 0.95rem;
    z-index: 1;
}
.cam-placeholder .cam-icon { font-size: 3rem; }
#video {
    width: 100%; height: 100%;
    display: block;
    transform: scaleX(-1);
    object-fit: cover;
    position: absolute;
    top: 0; left: 0;
    z-index: 2;
}
#overlay {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    transform: scaleX(-1);
    z-index: 3;
    pointer-events: none;
}
.scan-line {
    position: absolute;
    left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #7d5fff, transparent);
    animation: scan 2s linear infinite;
    z-index: 4;
    display: none;
}
.scanning .scan-line { display: block; }
@keyframes scan { 0% { top: 0; opacity:1; } 100% { top:100%; opacity:0.3; } }

/* Emotion pill */
.emotion-pill {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(125,95,255,0.25);
    border-radius: 60px;
    padding: 14px 24px;
    width: 420px;
}
.pill-emoji { font-size: 2.2rem; transition: 0.3s; }
.pill-info { flex: 1; }
.pill-label { font-size: 1.3rem; font-weight: 700; color: #a78bfa; text-transform: capitalize; line-height: 1; }
.pill-conf  { font-size: 0.8rem; color: rgba(255,255,255,0.4); margin-top: 4px; }
.conf-bar-bg {
    flex: 1;
    height: 6px;
    background: rgba(255,255,255,0.08);
    border-radius: 3px;
    overflow: hidden;
    min-width: 80px;
}
.conf-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #7d5fff, #a78bfa);
    border-radius: 3px;
    width: 0%;
    transition: width 0.4s ease;
}

#statusMsg {
    font-size: 0.85rem;
    color: #6ee7b7;
    text-align: center;
    min-height: 18px;
    width: 420px;
}

.btn-row { display: flex; gap: 12px; width: 420px; }
.btn {
    flex: 1; padding: 13px;
    border: none; border-radius: 14px;
    font-size: 0.9rem; font-weight: 600;
    cursor: pointer; transition: 0.2s;
    display: flex; align-items: center; justify-content: center; gap: 8px;
}
.btn:disabled { opacity: 0.5; cursor: not-allowed; }
.btn-primary { background: linear-gradient(135deg, #7d5fff, #a78bfa); color: #fff; }
.btn-primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(125,95,255,0.4); }
.btn-ghost { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #ccc; }
.btn-ghost:hover:not(:disabled) { background: rgba(255,255,255,0.1); }

/* ── Right Panel ── */
.right-panel {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 61px);
    overflow: hidden;
}

/* Tabs */
.tabs {
    display: flex;
    border-bottom: 1px solid rgba(125,95,255,0.2);
    background: rgba(255,255,255,0.02);
}
.tab {
    flex: 1; padding: 14px;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: 0.2s;
}
.tab.active { color: #a78bfa; border-bottom-color: #7d5fff; }

/* AI Panel */
.ai-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 24px;
    gap: 16px;
    overflow-y: auto;
}

.ai-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    color: rgba(255,255,255,0.2);
    text-align: center;
}
.ai-empty .big-icon { font-size: 4rem; }
.ai-empty p { font-size: 0.95rem; line-height: 1.7; }

.ai-loading {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
}
.spinner {
    width: 44px; height: 44px;
    border: 3px solid rgba(125,95,255,0.2);
    border-top-color: #7d5fff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.ai-loading p { color: rgba(255,255,255,0.4); font-size: 0.9rem; }

.ai-cards { display: flex; flex-direction: column; gap: 14px; }

.ai-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(125,95,255,0.2);
    border-radius: 18px;
    padding: 18px 20px;
    animation: fadeUp 0.4s ease forwards;
    opacity: 0;
}
.ai-card:nth-child(1) { animation-delay: 0.0s; }
.ai-card:nth-child(2) { animation-delay: 0.12s; }
.ai-card:nth-child(3) { animation-delay: 0.24s; }
@keyframes fadeUp { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:translateY(0); } }
.ai-card:hover { border-color: rgba(125,95,255,0.45); background: rgba(255,255,255,0.05); }
.card-header { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.card-icon   { font-size: 1.3rem; }
.card-title  { font-size: 0.78rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #a78bfa; }
.card-body   { font-size: 0.92rem; line-height: 1.75; color: rgba(255,255,255,0.8); white-space: pre-wrap; }

/* ── Chat Panel ── */
.chat-panel {
    flex: 1;
    display: none;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
}
.chat-panel.active { display: flex; }
.ai-panel.hidden   { display: none; }

.chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    scrollbar-width: thin;
    scrollbar-color: rgba(125,95,255,0.3) transparent;
}

.msg {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    animation: fadeUp 0.3s ease forwards;
}
.msg.user { flex-direction: row-reverse; }

.msg-avatar {
    width: 32px; height: 32px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
}
.msg.bot  .msg-avatar { background: rgba(125,95,255,0.2); border: 1px solid rgba(125,95,255,0.3); }
.msg.user .msg-avatar { background: rgba(16,185,129,0.2); border: 1px solid rgba(16,185,129,0.3); }

.msg-bubble {
    max-width: 75%;
    padding: 12px 16px;
    border-radius: 18px;
    font-size: 0.9rem;
    line-height: 1.65;
}
.msg.bot  .msg-bubble {
    background: rgba(125,95,255,0.12);
    border: 1px solid rgba(125,95,255,0.2);
    border-top-left-radius: 4px;
    color: rgba(255,255,255,0.9);
}
.msg.user .msg-bubble {
    background: rgba(16,185,129,0.12);
    border: 1px solid rgba(16,185,129,0.2);
    border-top-right-radius: 4px;
    color: rgba(255,255,255,0.9);
}

.typing-indicator {
    display: flex;
    gap: 5px;
    padding: 14px 16px;
    background: rgba(125,95,255,0.12);
    border: 1px solid rgba(125,95,255,0.2);
    border-radius: 18px;
    border-top-left-radius: 4px;
    width: fit-content;
}
.typing-indicator span {
    width: 7px; height: 7px;
    background: #a78bfa;
    border-radius: 50%;
    animation: bounce 1.2s infinite;
}
.typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
.typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
@keyframes bounce { 0%,60%,100% { transform:translateY(0); } 30% { transform:translateY(-6px); } }

.chat-input-area {
    padding: 16px 24px;
    border-top: 1px solid rgba(125,95,255,0.15);
    display: flex;
    gap: 10px;
    background: rgba(255,255,255,0.02);
}
.chat-input {
    flex: 1;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(125,95,255,0.25);
    border-radius: 14px;
    padding: 12px 16px;
    color: #fff;
    font-size: 0.9rem;
    outline: none;
    transition: 0.2s;
    resize: none;
    height: 46px;
    font-family: 'Segoe UI', sans-serif;
}
.chat-input:focus { border-color: rgba(125,95,255,0.6); background: rgba(255,255,255,0.07); }
.chat-input::placeholder { color: rgba(255,255,255,0.25); }
.send-btn {
    width: 46px; height: 46px;
    background: linear-gradient(135deg, #7d5fff, #a78bfa);
    border: none; border-radius: 14px;
    color: #fff; font-size: 1.1rem;
    cursor: pointer; transition: 0.2s;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
}
.send-btn:hover { transform: scale(1.05); box-shadow: 0 4px 15px rgba(125,95,255,0.4); }
.send-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

.quick-replies {
    display: flex;
    gap: 8px;
    padding: 0 24px 12px;
    flex-wrap: wrap;
}
.qr-btn {
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid rgba(125,95,255,0.3);
    background: rgba(125,95,255,0.08);
    color: rgba(255,255,255,0.6);
    font-size: 0.8rem;
    cursor: pointer;
    transition: 0.2s;
}
.qr-btn:hover { background: rgba(125,95,255,0.2); color: #fff; }
</style>

<div class="page">

    <!-- Header -->
    <div class="top-bar">
        <div class="logo">🧠 Mood<span>Forge</span></div>
        <a class="nav-btn" href="{{ path('app_emotion_history') }}">📋 History</a>
    </div>

    <!-- Left: Camera -->
    <div class="left-panel">
        <div class="cam-wrapper" id="camWrapper">
            <div class="cam-placeholder" id="camPlaceholder">
                <div class="cam-icon">📷</div>
                <div>Click Start to activate camera</div>
            </div>
            <div class="scan-line"></div>
            <video id="video" autoplay muted playsinline style="display:none;"></video>
            <canvas id="overlay"></canvas>
        </div>

        <div class="emotion-pill">
            <div class="pill-emoji" id="emotionEmoji">😐</div>
            <div class="pill-info">
                <div class="pill-label" id="emotionLabel">Waiting...</div>
                <div class="pill-conf"  id="confidenceLabel">Start camera to detect</div>
            </div>
            <div class="conf-bar-bg">
                <div class="conf-bar-fill" id="confBar"></div>
            </div>
        </div>

        <div id="statusMsg"></div>

        <div class="btn-row">
            <button class="btn btn-primary" id="startBtn">▶ Start Camera</button>
            <button class="btn btn-ghost"   id="reanalyzeBtn" disabled>🔄 Re-scan</button>
            <button class="btn btn-ghost"   id="saveBtn" disabled>💾 Save</button>
        </div>
    </div>

    <!-- Right: Tabs -->
    <div class="right-panel">
        <div class="tabs">
            <div class="tab active" id="tabInsights" onclick="switchTab('insights')">✨ Insights</div>
            <div class="tab"        id="tabChat"     onclick="switchTab('chat')">💬 Mental Health Chat</div>
        </div>

        <!-- Insights -->
        <div class="ai-panel" id="aiPanel">
            <div class="ai-empty" id="aiEmpty">
                <div class="big-icon">🧘</div>
                <p>Camera will scan your emotion<br>for 10 readings, then automatically<br>generate your <strong style="color:#a78bfa">mental health insights</strong>.</p>
            </div>
            <div class="ai-loading" id="aiLoading" style="display:none;">
                <div class="spinner"></div>
                <p>Analyzing your emotional state...</p>
            </div>
            <div class="ai-cards" id="aiCards" style="display:none;"></div>
        </div>

        <!-- Chat -->
        <div class="chat-panel" id="chatPanel">
            <div class="chat-messages" id="chatMessages"></div>
            <div class="quick-replies" id="quickReplies">
                <button class="qr-btn" onclick="sendQuick('I feel overwhelmed')">😩 Overwhelmed</button>
                <button class="qr-btn" onclick="sendQuick('I need help with anxiety')">😰 Anxiety</button>
                <button class="qr-btn" onclick="sendQuick('I feel lonely')">😔 Lonely</button>
                <button class="qr-btn" onclick="sendQuick('Help me calm down')">🌬️ Calm me down</button>
                <button class="qr-btn" onclick="sendQuick('I need motivation')">⚡ Motivation</button>
            </div>
            <div class="chat-input-area">
                <textarea class="chat-input" id="chatInput" placeholder="Talk to your mental health companion..." rows="1"></textarea>
                <button class="send-btn" id="sendBtn" onclick="sendMessage()">➤</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
<script>
// ── DOM ──
const video        = document.getElementById('video');
const overlay      = document.getElementById('overlay');
const ctx          = overlay.getContext('2d');
const emojiEl      = document.getElementById('emotionEmoji');
const labelEl      = document.getElementById('emotionLabel');
const confEl       = document.getElementById('confidenceLabel');
const confBar      = document.getElementById('confBar');
const statusEl     = document.getElementById('statusMsg');
const startBtn     = document.getElementById('startBtn');
const reanalyzeBtn = document.getElementById('reanalyzeBtn');
const saveBtn      = document.getElementById('saveBtn');
const camWrapper   = document.getElementById('camWrapper');
const placeholder  = document.getElementById('camPlaceholder');
const aiEmpty      = document.getElementById('aiEmpty');
const aiLoading    = document.getElementById('aiLoading');
const aiCards      = document.getElementById('aiCards');

const SAVE_URL  = "{{ path('app_emotion_save') }}";
const GROQ_URL  = "{{ path('app_emotion_groq') }}";
const MODEL_URL = 'https://cdn.jsdelivr.net/npm/@vladmandic/face-api/model';

const EMOJIS = {
    happy:'😄', sad:'😢', angry:'😡',
    fearful:'😨', disgusted:'🤢', surprised:'😲', neutral:'😐'
};

const SECTIONS = [
    { key: 'FEELING',     icon: '🧘', title: 'Understanding Your Feeling' },
    { key: 'SONG',        icon: '🎵', title: 'Healing Song'               },
    { key: 'EXERCISE',    icon: '💪', title: 'Mental Exercise'             },
];

let currentEmotion    = null;
let currentConfidence = 0;
let detecting         = false;
let emotionSamples    = [];
let samplesDone       = false;
let analyzing         = false;

// ── Chat state ──
let chatHistory = [];
let detectedEmotion = null;

// ── Tabs ──
function switchTab(tab) {
    document.getElementById('tabInsights').classList.toggle('active', tab === 'insights');
    document.getElementById('tabChat').classList.toggle('active', tab === 'chat');
    document.getElementById('aiPanel').classList.toggle('hidden', tab !== 'insights');
    document.getElementById('chatPanel').classList.toggle('active', tab === 'chat');

    if (tab === 'chat' && chatHistory.length === 0) {
        const greeting = detectedEmotion
            ? `Hi! I can see you're feeling ${detectedEmotion} right now. I'm here to listen and support you. How are you doing?`
            : `Hi! I'm your mental health companion. I'm here to listen, support, and help you feel better. What's on your mind?`;
        addBotMessage(greeting);
    }
}

// ── Chat functions ──
function addBotMessage(text) {
    const msgs = document.getElementById('chatMessages');
    const div  = document.createElement('div');
    div.className = 'msg bot';
    div.innerHTML = `
        <div class="msg-avatar">🧠</div>
        <div class="msg-bubble">${text}</div>
    `;
    msgs.appendChild(div);
    msgs.scrollTop = msgs.scrollHeight;
    chatHistory.push({ role: 'assistant', content: text });
}

function addUserMessage(text) {
    const msgs = document.getElementById('chatMessages');
    const div  = document.createElement('div');
    div.className = 'msg user';
    div.innerHTML = `
        <div class="msg-avatar">🙂</div>
        <div class="msg-bubble">${text}</div>
    `;
    msgs.appendChild(div);
    msgs.scrollTop = msgs.scrollHeight;
    chatHistory.push({ role: 'user', content: text });
}

function showTyping() {
    const msgs = document.getElementById('chatMessages');
    const div  = document.createElement('div');
    div.className = 'msg bot';
    div.id = 'typingIndicator';
    div.innerHTML = `
        <div class="msg-avatar">🧠</div>
        <div class="typing-indicator">
            <span></span><span></span><span></span>
        </div>
    `;
    msgs.appendChild(div);
    msgs.scrollTop = msgs.scrollHeight;
}

function removeTyping() {
    const t = document.getElementById('typingIndicator');
    if (t) t.remove();
}

async function sendMessage() {
    const input   = document.getElementById('chatInput');
    const sendBtn = document.getElementById('sendBtn');
    const text    = input.value.trim();
    if (!text) return;

    input.value   = '';
    sendBtn.disabled = true;
    document.getElementById('quickReplies').style.display = 'none';

    addUserMessage(text);
    showTyping();

    const systemPrompt = `You are a compassionate, professional mental health companion.
${detectedEmotion ? `The user's detected emotion via facial analysis is: ${detectedEmotion}.` : ''}
Your role is to:
- Listen actively and empathetically
- Provide emotional support and validation
- Suggest practical mental health techniques (breathing, grounding, mindfulness)
- Never diagnose or replace professional therapy
- Gently encourage professional help when needed
- Keep responses warm, concise and supportive (max 3-4 sentences)
- Use simple, caring language`;

    const messages = [
        { role: 'system', content: systemPrompt },
        ...chatHistory.slice(-10) // keep last 10 messages for context
    ];

    try {
        const res  = await fetch(GROQ_URL, {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ chat: true, messages })
        });
        const data = await res.json();
        removeTyping();

        if (data.success) {
            addBotMessage(data.content);
        } else {
            addBotMessage("I'm having trouble connecting right now. Please try again in a moment.");
        }
    } catch(e) {
        removeTyping();
        addBotMessage("I'm having trouble connecting right now. Please try again.");
    }

    sendBtn.disabled = false;
    input.focus();
}

function sendQuick(text) {
    document.getElementById('chatInput').value = text;
    sendMessage();
}

// Enter key to send
document.getElementById('chatInput').addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
    }
});

// ── Parse AI insights ──
function parseResponse(text) {
    const result = {};
    SECTIONS.forEach(s => {
        const regex = new RegExp(`${s.key}[:\\s]+(.*?)(?=FEELING:|SONG:|EXERCISE:|$)`, 'si');
        const match = text.match(regex);
        result[s.key] = match ? match[1].trim() : '';
    });
    return result;
}

function showCards(text) {
    aiLoading.style.display = 'none';
    aiCards.style.display   = 'flex';
    aiEmpty.style.display   = 'none';
    aiCards.innerHTML       = '';

    const parsed = parseResponse(text);
    SECTIONS.forEach(s => {
        if (!parsed[s.key]) return;
        const card = document.createElement('div');
        card.className = 'ai-card';
        card.innerHTML = `
            <div class="card-header">
                <span class="card-icon">${s.icon}</span>
                <span class="card-title">${s.title}</span>
            </div>
            <div class="card-body">${parsed[s.key]}</div>
        `;
        aiCards.appendChild(card);
    });
}

// ── Dominant emotion from samples ──
function getDominant(samples) {
    const counts = {};
    samples.forEach(e => counts[e] = (counts[e] || 0) + 1);
    return Object.entries(counts).sort((a,b) => b[1]-a[1])[0][0];
}

// ── Auto analyze ──
async function autoAnalyze(emotion) {
    if (analyzing) return;
    analyzing = true;
    detectedEmotion = emotion;

    aiEmpty.style.display   = 'none';
    aiCards.style.display   = 'none';
    aiLoading.style.display = 'flex';
    statusEl.textContent    = '🤖 Generating insights...';

    fetch(SAVE_URL, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ emotion, confidence: currentConfidence })
    });

    try {
        const res  = await fetch(GROQ_URL, {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ emotion })
        });
        const data = await res.json();

        if (data.success) {
            showCards(data.content);
            statusEl.textContent = '✅ Insights ready — emotion: ' + emotion;
        } else {
            aiLoading.style.display = 'none';
            aiEmpty.style.display   = 'flex';
            statusEl.textContent    = '❌ ' + data.error;
        }
    } catch(e) {
        aiLoading.style.display = 'none';
        aiEmpty.style.display   = 'flex';
        statusEl.textContent    = '❌ Request failed.';
    }

    reanalyzeBtn.disabled = false;
    analyzing = false;
}

// ── Face-api models ──
async function loadModels() {
    statusEl.textContent = '⏳ Loading models...';
    await faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL);
    await faceapi.nets.faceExpressionNet.loadFromUri(MODEL_URL);
    statusEl.textContent = '✓ Ready — look at the camera!';
}

// ── Camera ──
async function startCamera() {
    const stream = await navigator.mediaDevices.getUserMedia({ video: true });
    video.srcObject = stream;
    video.style.display = 'block';
    placeholder.style.display = 'none';
    camWrapper.classList.add('scanning');

    video.onloadedmetadata = () => {
        overlay.width  = video.videoWidth  || 420;
        overlay.height = video.videoHeight || 300;
        detecting = true;
        detectLoop();
        saveBtn.disabled = false;
        statusEl.textContent = '🔍 Sampling 0/10...';
    };
}

// ── Detection loop ──
async function detectLoop() {
    if (!detecting) return;

    const result = await faceapi
        .detectSingleFace(video, new faceapi.TinyFaceDetectorOptions())
        .withFaceExpressions();

    ctx.clearRect(0, 0, overlay.width, overlay.height);

    if (result) {
        const box = result.detection.box;
        ctx.strokeStyle = '#7d5fff';
        ctx.lineWidth   = 2;
        ctx.strokeRect(box.x, box.y, box.width, box.height);

        const cs = 14;
        ctx.strokeStyle = '#a78bfa';
        ctx.lineWidth   = 3;
        [
            [box.x,           box.y,            1,  1],
            [box.x+box.width, box.y,            -1,  1],
            [box.x,           box.y+box.height,  1, -1],
            [box.x+box.width, box.y+box.height, -1, -1],
        ].forEach(([cx,cy,dx,dy]) => {
            ctx.beginPath();
            ctx.moveTo(cx+dx*cs, cy);
            ctx.lineTo(cx, cy);
            ctx.lineTo(cx, cy+dy*cs);
            ctx.stroke();
        });

        const expressions = result.expressions;
        const dominant    = Object.entries(expressions).sort((a,b)=>b[1]-a[1])[0];
        currentEmotion    = dominant[0];
        currentConfidence = (dominant[1]*100).toFixed(1);

        emojiEl.textContent = EMOJIS[currentEmotion] ?? '😐';
        labelEl.textContent = currentEmotion;
        confEl.textContent  = `Confidence: ${currentConfidence}%`;

        if (!samplesDone) {
            emotionSamples.push(currentEmotion);
            const pct = Math.round((emotionSamples.length / 10) * 100);
            confBar.style.width  = pct + '%';
            statusEl.textContent = `🔍 Sampling ${emotionSamples.length}/10...`;

            if (emotionSamples.length >= 10) {
                samplesDone = true;
                const avg   = getDominant(emotionSamples);
                emojiEl.textContent = EMOJIS[avg] ?? '😐';
                labelEl.textContent = avg + ' (avg)';
                confBar.style.width = '100%';
                autoAnalyze(avg);
            }
        }
    } else {
        labelEl.textContent = 'No face detected';
        confEl.textContent  = 'Position your face in frame';
        emojiEl.textContent = '🔍';
        if (!samplesDone) confBar.style.width = '0%';
    }

    setTimeout(detectLoop, 500);
}

// ── Buttons ──
startBtn.addEventListener('click', async () => {
    startBtn.disabled    = true;
    startBtn.textContent = '⏳ Loading...';
    try {
        await loadModels();
        await startCamera();
        startBtn.textContent  = '📷 Running';
        reanalyzeBtn.disabled = false;
    } catch(e) {
        statusEl.textContent = '❌ Camera access denied.';
        startBtn.disabled    = false;
        startBtn.textContent = '▶ Start Camera';
    }
});

reanalyzeBtn.addEventListener('click', () => {
    emotionSamples = [];
    samplesDone    = false;
    analyzing      = false;
    confBar.style.width  = '0%';
    statusEl.textContent = '🔍 Re-sampling...';
    aiCards.style.display   = 'none';
    aiLoading.style.display = 'none';
    aiEmpty.style.display   = 'flex';
});

saveBtn.addEventListener('click', () => {
    if (!currentEmotion) return;
    saveBtn.disabled    = true;
    saveBtn.textContent = '⏳...';
    fetch(SAVE_URL, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ emotion: currentEmotion, confidence: currentConfidence })
    })
    .then(r=>r.json())
    .then(d => { statusEl.textContent = d.success ? '✅ Saved!' : '❌ ' + d.error; })
    .catch(()=> { statusEl.textContent = '❌ Failed.'; })
    .finally(()=> {
        saveBtn.disabled    = false;
        saveBtn.textContent = '💾 Save';
    });
});
</script>
{% endblock %}
