{% extends 'admin/base.html.twig' %}

{% block title %}Guardian AI Insights{% endblock %}
{% block body_class %}guardian-admin-ui{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .guardian-ai-insights-page {
            background: #f3f5f8;
            border-radius: 18px;
            padding: 16px;
            margin-top: 12px;
            margin-bottom: 18px;
        }

        .guardian-ai-insights-page .guardian-admin-card {
            overflow: hidden;
        }

        .guardian-chart-card {
            min-height: 320px;
            display: flex;
            flex-direction: column;
        }

        .guardian-chart-body {
            position: relative;
            flex: 1;
            min-height: 240px;
        }

        .guardian-insights-table {
            margin-top: 4px;
        }
    </style>
{% endblock %}

{% block content %}
<div class="container-fluid guardian-ai-insights-page">
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="guardian-admin-hero">
                <h1>Guardian AI Insights</h1>
                <p class="text-muted mb-0">History of AI and fallback outputs generated by the Focus Timer APIs.</p>
            </div>
        </div>
        <div class="col-md-4">
            <form method="GET" class="guardian-admin-card p-3">
                <div class="mb-2">
                    <label for="type" class="form-label mb-1">Type</label>
                    <select id="type" name="type" class="form-select">
                        <option value="">All</option>
                        {% for type_key, type_label in type_labels %}
                            <option value="{{ type_key }}" {% if filters.type == type_key %}selected{% endif %}>{{ type_label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="mb-2">
                    <label for="source" class="form-label mb-1">Source</label>
                    <select id="source" name="source" class="form-select">
                        <option value="">All</option>
                        <option value="ai" {% if filters.source == 'ai' %}selected{% endif %}>AI</option>
                        <option value="rule" {% if filters.source == 'rule' %}selected{% endif %}>Rule</option>
                    </select>
                </div>
                <label for="limit" class="form-label mb-1">Rows per page</label>
                <div class="d-flex gap-2 align-items-end">
                    <input id="limit" name="limit" type="number" min="10" max="200" value="{{ limit }}" class="form-control">
                    <button class="btn btn-primary" type="submit">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-4 mb-3 mb-lg-0">
            <div class="guardian-admin-card guardian-chart-card p-3">
                <h6 class="mb-3">Source Distribution</h6>
                <div class="guardian-chart-body">
                    {{ render_chart(source_chart) }}
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="guardian-admin-card guardian-chart-card p-3">
                <h6 class="mb-3">Type Distribution</h6>
                <div class="guardian-chart-body">
                    {{ render_chart(type_chart) }}
                </div>
            </div>
        </div>
    </div>

    {% if insights is empty %}
        <div class="guardian-admin-card p-4 text-center">
            No AI insights available.
        </div>
    {% else %}
        <div class="guardian-admin-card guardian-insights-table p-3 table-responsive">
            <table class="table guardian-admin-table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>User</th>
                        <th>Task</th>
                        <th>Type</th>
                        <th>Source</th>
                        <th>Feedback</th>
                        <th>Payload</th>
                    </tr>
                </thead>
                <tbody>
                    {% for insight in insights %}
                        <tr>
                            <td>{{ insight.createdAt ? insight.createdAt|date('d/m/Y H:i:s') : '—' }}</td>
                            <td>
                                {{ insight.user and insight.user.profile and insight.user.profile.fullName
                                    ? insight.user.profile.fullName
                                    : (insight.user ? insight.user.userIdentifier : '—')
                                }}
                            </td>
                            <td>{{ insight.task ? insight.task.title : '—' }}</td>
                            <td>{{ type_labels[insight.type] ?? insight.type }}</td>
                            <td>
                                {% if insight.source == 'ai' %}
                                    <span class="badge bg-success">AI</span>
                                {% else %}
                                    <span class="badge bg-secondary">Rule</span>
                                {% endif %}
                            </td>
                            <td>
                                <small>
                                    👍 {{ insight.helpfulVotes }} / 👎 {{ insight.unhelpfulVotes }}
                                </small>
                            </td>
                            <td><small>{{ insight.payload|slice(0, 200) }}{% if insight.payload|length > 200 %}...{% endif %}</small></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            {{ knp_pagination_render(insights) }}
        </div>
    {% endif %}
</div>
{% endblock %}
