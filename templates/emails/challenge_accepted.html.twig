<html>
<head>
    <meta charset="utf-8">
    <style>
        body { font-family: Arial, sans-serif; background-color: #f4f4f4; }
        .container { max-width: 600px; margin: 20px auto; background: white; padding: 20px; border-radius: 8px; }
        .header { color: #333; border-bottom: 3px solid #4CAF50; padding-bottom: 15px; }
        .content { margin: 20px 0; line-height: 1.6; }
        .challenge-card { background: #f9f9f9; padding: 15px; border-left: 4px solid #4CAF50; margin: 15px 0; }
        .button { display: inline-block; background: #4CAF50; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; margin-top: 15px; }
        .footer { color: #999; font-size: 12px; border-top: 1px solid #ddd; padding-top: 15px; margin-top: 20px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>✅ Défi accepté !</h1>
        </div>

        <div class="content">
            <p>Félicitations ! 🎉</p>

            <p><strong>{{ accepted_by.profile.firstName ?? 'Un utilisateur' }} {{ accepted_by.profile.lastName ?? '' }}</strong> a accepté votre défi :</p>

            <div class="challenge-card">
                <h2 style="margin-top: 0; color: #4CAF50;">{{ task.title }}</h2>
                <p>{{ task.description }}</p>
                <p style="color: #999; font-size: 14px;">
                    ⏱️ Accepté le {{ task.respondedAt|date('d/m/Y à H:i') }}
                </p>
            </div>

            <p>Le défi est en cours ! Patience... 💪</p>

            <a href="https://mindforge.local/community/challenge/outbox" class="button">Voir mon défi</a>
        </div>

        <div class="footer">
            <p>&copy; 2026 MindForge. Tous droits réservés.</p>
        </div>
    </div>
</body>
</html>
