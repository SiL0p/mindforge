{% extends 'workspace/module_base.html.twig' %}

{% block title %}Planner Hub{% endblock %}
{% block body_class %}guardian-ui{% endblock %}

{% block module_title %}Planner Hub{% endblock %}
{% block module_subtitle %}Choose your planning mode: Tasks, Exams, or Calendar.{% endblock %}

{% block module_content %}
<div class="container-fluid" style="margin-top: 20px; margin-bottom: 30px;">
    <div class="row">
        {% include 'components/_sidebar_planner.html.twig' %}

        <main class="col-md-9 col-lg-10">
            <div class="guardian-shell">
                <section class="guardian-hero mb-4">
                    <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
                        <div>
                            <span class="guardian-pill"><i class="fas fa-calendar-check"></i> Planner</span>
                            <h1 class="guardian-title">What do you want to plan?</h1>
                            <p class="guardian-subtitle">Open your task board, manage exams, or view everything in calendar mode.</p>
                        </div>
                    </div>
                </section>

                <section class="guardian-panel p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <a href="{{ path('app_planner_tasks') }}" class="guardian-card p-3 h-100 text-decoration-none d-flex flex-column justify-content-between">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="me-3 d-flex align-items-center justify-content-center" style="width:56px;height:56px;border-radius:12px;background:linear-gradient(180deg,#ffffff,#f7f8fa);box-shadow:0 1px 2px rgba(16,24,40,0.03);">
                                        <i class="fas fa-tasks" style="color:#3b82f6;font-size:20px;"></i>
                                    </div>
                                    <h4 class="mb-0" style="color:#1f2937;">Tasks</h4>
                                </div>
                                <p class="text-muted mb-2">Manage your task board and update progress by status.</p>
                                <span class="text-primary small">Open tasks →</span>
                            </a>
                        </div>

                        <div class="col-md-4">
                            <a href="{{ path('app_planner_exams') }}" class="guardian-card p-3 h-100 text-decoration-none d-flex flex-column justify-content-between">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="me-3 d-flex align-items-center justify-content-center" style="width:56px;height:56px;border-radius:12px;background:linear-gradient(180deg,#ffffff,#f7f8fa);box-shadow:0 1px 2px rgba(16,24,40,0.03);">
                                        <i class="fas fa-graduation-cap" style="color:#7c3aed;font-size:20px;"></i>
                                    </div>
                                    <h4 class="mb-0" style="color:#1f2937;">Exams</h4>
                                </div>
                                <p class="text-muted mb-2">Review upcoming exams, create new ones, and adjust plans.</p>
                                <span class="text-primary small">Open exams →</span>
                            </a>
                        </div>

                        <div class="col-md-4">
                            <a href="{{ path('app_planner_calendar') }}" class="guardian-card p-3 h-100 text-decoration-none d-flex flex-column justify-content-between">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="me-3 d-flex align-items-center justify-content-center" style="width:56px;height:56px;border-radius:12px;background:linear-gradient(180deg,#ffffff,#f7f8fa);box-shadow:0 1px 2px rgba(16,24,40,0.03);">
                                        <i class="fas fa-calendar-alt" style="color:#06b6d4;font-size:20px;"></i>
                                    </div>
                                    <h4 class="mb-0" style="color:#1f2937;">Calendar</h4>
                                </div>
                                <p class="text-muted mb-2">See tasks and exams together on the planner timeline.</p>
                                <span class="text-primary small">Open calendar →</span>
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </div>
</div>
{% endblock %}
