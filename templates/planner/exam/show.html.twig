{% extends 'workspace/module_base.html.twig' %}

{% block title %}Exam Details - {{ exam.title }}{% endblock %}

{% block module_title %}Exam Details{% endblock %}
{% block module_subtitle %}Review your AI-generated preparation plan.{% endblock %}
{% block module_content %}
<div class="container-fluid" style="margin-top: 20px;">
    <div class="row">
        {% include 'components/_sidebar_planner.html.twig' %}

        <main class="col-md-9 col-lg-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>{{ exam.title }}</h1>
                <div>
                    <a href="{{ path('app_planner_exam_edit', {'id': exam.id}) }}" class="btn btn-warning"><i class="fa fa-edit"></i> Edit</a>
                    <a href="{{ path('app_planner_exams') }}" class="btn btn-secondary"><i class="fa fa-arrow-left"></i> Back to Exams</a>
                </div>
            </div>

            <div class="row">
                <!-- Exam Info Card -->
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="mb-0 text-primary"><i class="fa fa-info-circle"></i> Exam Details</h5>
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span><strong>Subject:</strong></span>
                                    <span>{{ exam.subject ? exam.subject.name : 'N/A' }}</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span><strong>Date:</strong></span>
                                    <span>{{ exam.examDate|date('M d, Y H:i') }}</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span><strong>Duration:</strong></span>
                                    <span>{{ exam.durationMinutes ? exam.durationMinutes ~ ' min' : 'N/A' }}</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span><strong>Importance:</strong></span>
                                    <span><span class="badge bg-danger rounded-pill">{{ exam.importance }}/10</span></span>
                                </li>
                                {% if exam.location %}
                                <li class="list-group-item px-0">
                                    <strong>Location:</strong><br>
                                    <span class="text-muted">{{ exam.location }}</span>
                                </li>
                                {% endif %}
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- AI Insights Card -->
                <div class="col-md-8 mb-4">
                    <div class="card shadow-sm border-info h-100">
                        <div class="card-header bg-info text-white border-bottom d-flex align-items-center">
                            <h5 class="mb-0"><i class="fa fa-robot me-2"></i> AI Preparation Analyst</h5>
                        </div>
                        <div class="card-body">
                            <div class="row mb-4 text-center">
                                <div class="col-6 border-end">
                                    <h6 class="text-muted text-uppercase small font-weight-bold">Preparation Score</h6>
                                    <div class="display-4 font-weight-bold {% if prepScore >= 70 %}text-success{% elseif prepScore >= 40 %}text-warning{% else %}text-danger{% endif %}">
                                        {{ prepScore }}%
                                    </div>
                                    <div class="progress mt-2" style="height: 10px;">
                                        <div class="progress-bar {% if prepScore >= 70 %}bg-success{% elseif prepScore >= 40 %}bg-warning{% else %}bg-danger{% endif %}" role="progressbar" style="width: {{ prepScore }}%" aria-valuenow="{{ prepScore }}" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <h6 class="text-muted text-uppercase small font-weight-bold">Success Probability</h6>
                                    <div class="display-4 font-weight-bold text-primary">
                                        {{ successProbability }}%
                                    </div>
                                    <p class="small text-muted mt-2 mb-0">Based on task completion and importance.</p>
                                </div>
                            </div>

                            <hr>

                            <div class="d-flex justify-content-between align-items-center mt-3 mb-3">
                                <h5><i class="fa fa-calendar-check text-primary"></i> Suggested Revision Plan</h5>
                                {% if exam.aiRevisionPlan %}
                                <button type="button" id="btn-read-plan" class="btn btn-sm btn-outline-primary">
                                    <i class="fa fa-volume-up"></i> Read Aloud
                                </button>
                                {% endif %}
                            </div>
                            
                            {% if exam.aiRevisionPlan %}
                                <div class="timeline">
                                    {% for step in exam.aiRevisionPlan %}
                                    <div class="d-flex mb-3">
                                        <div class="me-3 text-end" style="min-width: 80px;">
                                            <span class="badge bg-light text-dark border">{{ step.day }}</span>
                                        </div>
                                        <div class="flex-grow-1 border-start ps-3 border-primary" style="border-width: 3px !important;">
                                            <p class="mb-0">{{ step.action }}</p>
                                        </div>
                                    </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <div class="alert alert-secondary">
                                    <i class="fa fa-info-circle"></i> Edit this exam and save to lazily generate the AI plan.
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Text AI Tutor Card -->
            <div class="card shadow-sm border-primary mb-4" id="tutor-section" style="border-width: 2px !important;">
                <div class="card-header bg-primary text-white border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="mb-0"><i class="fa fa-comments me-2"></i> AI Tutor Chat</h5>
                    <span class="badge bg-light text-primary"><i class="fa fa-bolt text-warning"></i> Powered by Groq</span>
                </div>
                <div class="card-body d-flex flex-column" style="height: 440px;">
                    <p class="mb-3 text-muted small">Ask me anything about <strong>{{ exam.subject ? exam.subject.name : 'this exam' }}</strong>.</p>
                    
                    <!-- Chat History -->
                    <div id="tutor-chat-history" class="bg-light rounded p-3 mb-3 border shadow-inner" style="display: flex; flex-direction: column; gap: 15px; overflow-y: auto; flex-grow: 1;">
                        <!-- Initial message -->
                        <div class="d-flex align-items-start w-100 mb-2">
                            <div class="bg-white border rounded p-2 shadow-sm" style="max-width: 85%;">
                                <div class="text-primary fw-bold small mb-1"><i class="fa fa-robot"></i> AI Tutor</div>
                                <div class="text-dark small">Hello! I am here to help you study for your {{ exam.subject ? exam.subject.name : exam.title }} exam. What would you like to know?</div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Text Input -->
                    <div class="input-group mt-auto">
                        <input type="text" id="tutor-input" class="form-control focus-ring" placeholder="Type your question here..." autocomplete="off" />
                        <button class="btn btn-primary" id="btn-tutor-send">
                            <i class="fa fa-paper-plane"></i> Send
                        </button>
                    </div>
                </div>
            </div>

            {% if exam.description %}
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Description</h5>
                </div>
                <div class="card-body">
                    {{ exam.description|nl2br }}
                </div>
            </div>
            {% endif %}

        </main>
    </div>
</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const btnRead = document.getElementById('btn-read-plan');
    if (!btnRead) return;

    if (!('speechSynthesis' in window)) {
        btnRead.style.display = 'none';
        return;
    }

    let isPlaying = false;

    btnRead.addEventListener('click', () => {
        if (isPlaying) {
            window.speechSynthesis.cancel();
            isPlaying = false;
            btnRead.innerHTML = '<i class="fa fa-volume-up"></i> Read Aloud';
            return;
        }

        const title = "{{ exam.title|escape('js') }}";
        const importance = {{ exam.importance|default(5) }};
        const dateStr = "{{ exam.examDate|date('Y-m-d') }}";
        
        const examDate = new Date(dateStr);
        const today = new Date();
        const diffTime = examDate.getTime() - today.getTime();
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); 
        
        let importanceText = "important";
        if (importance >= 8) importanceText = "highly important";
        else if (importance <= 3) importanceText = "not very important";

        let textToRead = `Your ${title} is in ${Math.max(0, diffDays)} days. This exam is ${importanceText}. `;
        
        const steps = document.querySelectorAll('.timeline .d-flex');
        if (steps.length > 0) {
            textToRead += "Here is your suggested plan. ";
            steps.forEach(step => {
                const day = step.querySelector('.badge').innerText;
                const action = step.querySelector('p').innerText;
                textToRead += `For ${day}: ${action}. `;
            });
        }

        const utterance = new SpeechSynthesisUtterance(textToRead);
        utterance.lang = 'en-US'; // Set explicit language
        
        // Wait for voices to load or get them immediately
        let voices = window.speechSynthesis.getVoices();
        if (voices.length > 0) {
            const englishVoices = voices.filter(v => v.lang.startsWith('en'));
            if (englishVoices.length > 0) {
                // Try to favor specific high-quality English voices (Google US/UK, Microsoft Zira/David, etc)
                utterance.voice = englishVoices.find(v => v.name.includes('Google') || v.name.includes('Zira') || v.name.includes('Mark')) || englishVoices[0];
            }
        }
        
        utterance.onend = () => {
            isPlaying = false;
            btnRead.innerHTML = '<i class="fa fa-volume-up"></i> Read Aloud';
        };

        isPlaying = true;
        btnRead.innerHTML = '<i class="fa fa-stop"></i> Stop';
        window.speechSynthesis.speak(utterance);
    });
    
    // Voices might load asynchronously depending on OS/Browser
    window.speechSynthesis.onvoiceschanged = () => {
        window.speechSynthesis.getVoices();
    };

    // Text AI Tutor Logic
    const tutorInput = document.getElementById('tutor-input');
    const btnTutorSend = document.getElementById('btn-tutor-send');
    const chatHistory = document.getElementById('tutor-chat-history');
    
    if (chatHistory) {
        // Auto-scroll to bottom of chat
        function scrollToBottom() {
            chatHistory.scrollTop = chatHistory.scrollHeight;
        }

        // Add message to chat UI
        function addMessage(sender, text, isError = false) {
            const msgDiv = document.createElement('div');
            msgDiv.className = `d-flex align-items-start w-100 ${sender === 'user' ? 'justify-content-end mb-2' : 'mb-2'}`;
            
            let headerLabel = sender === 'user' ? 'You' : 'AI Tutor';
            let headerIcon = sender === 'user' ? 'fa-user' : 'fa-robot';
            let headerColor = sender === 'user' ? 'text-light' : 'text-primary';
            let bubbleClass = sender === 'user' ? 'bg-primary text-white border-primary border' : 'bg-white border text-dark';
            
            if (isError) {
                headerColor = 'text-white';
                bubbleClass = 'bg-danger text-white border-danger border';
            }

            msgDiv.innerHTML = `
                <div class="${bubbleClass} rounded p-2 shadow-sm" style="max-width: 85%;">
                    <div class="${headerColor} fw-bold small mb-1"><i class="fa ${headerIcon}"></i> ${headerLabel}</div>
                    <div style="white-space: pre-wrap; font-size: 0.9rem;">${text}</div>
                </div>
            `;
            
            chatHistory.appendChild(msgDiv);
            scrollToBottom();
        }

        async function processQuestion(question) {
            btnTutorSend.disabled = true;
            tutorInput.disabled = true;
            
            // Setup typing indicator
            const typingId = 'typing-' + Date.now();
            const typingDiv = document.createElement('div');
            typingDiv.className = 'd-flex align-items-start w-100 mb-2';
            typingDiv.id = typingId;
            typingDiv.innerHTML = `
                <div class="bg-light border rounded p-2 shadow-sm text-center" style="max-width: 85%; min-width: 100px;">
                    <div class="text-muted small"><i class="fa fa-circle-notch fa-spin me-1"></i> AI is typing...</div>
                </div>
            `;
            chatHistory.appendChild(typingDiv);
            scrollToBottom();
            
            const apiKey = '{{ groq_api_key }}';
            const subject = "{{ exam.subject ? exam.subject.name|escape('js') : exam.title|escape('js') }}";
            
            const systemPrompt = "You are a helpful, expert AI tutor text messaging a student preparing for an exam. The specific subject of this exam is: '" + subject + "'. CRITICAL RULES: 1. ONLY answer questions related to '" + subject + "' or general study techniques. 2. If the user asks a question COMPLETELY UNRELATED to '" + subject + "', you MUST politely decline and remind them that you are specifically here to help with '" + subject + "'. 3. Keep your answers concise, encouraging, and clear. Note that the student is interacting with you via a chat interface.";

            // Collect history from DOM (optional enhancement: we could just send the latest question, but a chat usually includes context)
            const messages = [
                { role: 'system', content: systemPrompt }
            ];
            
            // Just send the user's latest query for now to guarantee the schema is correct without hitting token limits
            messages.push({ role: 'user', content: question });

            try {
                const response = await fetch('https://api.groq.com/openai/v1/chat/completions', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${apiKey}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        model: 'llama-3.1-8b-instant',
                        messages: messages,
                        max_tokens: 400,
                        temperature: 0.7
                    })
                });

                if (!response.ok) {
                    const errData = await response.json();
                    console.error("Groq API Error Details:", errData);
                    throw new Error(`API error: ${response.status} - ${errData.error?.message || 'Unknown error'}`);
                }

                const data = await response.json();
                const answer = data.choices[0].message.content;
                
                // Remove typing indicator
                const typingEl = document.getElementById(typingId);
                if (typingEl) typingEl.remove();
                
                // Add real answer
                addMessage('ai', answer);
                
            } catch (error) {
                console.error("API Error:", error);
                const typingEl = document.getElementById(typingId);
                if (typingEl) typingEl.remove();
                addMessage('ai', "Failed to get a response. Please check your connection and try again.", true);
            } finally {
                btnTutorSend.disabled = false;
                tutorInput.disabled = false;
                tutorInput.focus();
            }
        }

        function handleSend() {
            const text = tutorInput.value.trim();
            if (text) {
                addMessage('user', text);
                tutorInput.value = '';
                processQuestion(text);
            }
        }

        btnTutorSend?.addEventListener('click', handleSend);
        tutorInput?.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                handleSend();
            }
        });
    }
});
</script>
{% endblock %}
