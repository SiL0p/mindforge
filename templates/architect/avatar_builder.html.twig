{% extends 'base.html.twig' %}
{% block body %}

<style>
.container {
    max-width: 1000px;
    margin: 50px auto;
    display: flex;
    gap: 40px;
}
.preview {
    width: 250px;
    height: 250px;
    border-radius: 50%;
    overflow: hidden;
    border: 4px solid #7d5fff;
}
.preview img {
    width: 100%;
    height: 100%;
}
.grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}
.card {
    background: #f1f2f6;
    padding: 10px;
    border-radius: 12px;
    cursor: pointer;
}
.card img {
    width: 100%;
}
</style>

<div class="container">
    <div>
        <div class="preview">
            <img id="avatarPreview"
                 src="{{ path('avatar_preview', {seed: 'user', top: 'longHairBigHair'}) }}">
        </div>

        <button onclick="saveAvatar()">Save Avatar</button>
    </div>

    <div class="grid" id="hairGrid"></div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const preview = document.getElementById("avatarPreview");
    const hairGrid = document.getElementById("hairGrid");
    const seed = "user";

    const hairStyles = [
        "longHairBigHair",
        "longHairBob",
        "longHairCurly",
        "longHairStraight",
        "shortHairDreads01",
        "shortHairDreads02",
        "shortHairFrizzle",
        "shortHairShaggyMullet"
    ];

    hairStyles.forEach(style => {
        const card = document.createElement("div");
        card.className = "card";

        const img = document.createElement("img");
        img.src = `{{ path('avatar_preview') }}?seed=${seed}&top=${style}&hairColor=brown`;
        card.appendChild(img);

        card.onclick = () => {
            preview.src = `{{ path('avatar_preview') }}?seed=${seed}&top=${style}&hairColor=brown`;
        };

        hairGrid.appendChild(card);
    });

    window.saveAvatar = function () {
        fetch("{{ path('avatar_save') }}", {
            method: "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify({avatar: preview.src})
        })
        .then(res => res.json())
        .then(() => alert("Saved!"));
    };
});
</script>

{% endblock %}
