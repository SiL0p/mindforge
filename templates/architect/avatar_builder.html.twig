{% extends 'base.html.twig' %}
{% block body %}
<style>
.av-wrap { max-width: 900px; margin: 40px auto; display: flex; gap: 40px; align-items: flex-start; }
.av-preview { width: 200px; height: 200px; border-radius: 50%; overflow: hidden; border: 4px solid #7d5fff; flex-shrink: 0; }
.av-preview img { width: 100%; height: 100%; }
.av-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; flex: 1; }
.av-card { background: #f1f2f6; border-radius: 10px; padding: 8px; cursor: pointer; border: 3px solid transparent; }
.av-card:hover { border-color: #a78bfa; }
.av-card.active { border-color: #7d5fff; }
.av-card img { width: 100%; display: block; }
.av-save { margin-top: 12px; padding: 10px 20px; background: #7d5fff; color: #fff; border: none; border-radius: 8px; cursor: pointer; width: 100%; font-size: 15px; }
.av-save:disabled { opacity: 0.6; cursor: not-allowed; }
</style>

<div class="av-wrap">
    <div>
        <div class="av-preview">
            <img id="previewImg" src="" alt="Avatar Preview">
        </div>
        <button class="av-save" id="saveBtn">Save Avatar</button>
    </div>
    <div class="av-grid" id="grid"></div>
</div>

<script>
const BASE = "{{ path('app_avatar_preview') }}";
const SAVE = "{{ path('app_generate_avatar') }}";
const seed = "{{ app.user.id ?? 'user' }}";

const styles = [
    "longHairBigHair", "longHairBob", "longHairCurly", "longHairStraight",
    "shortHairDreads01", "shortHairDreads02", "shortHairFrizzle", "shortHairShaggyMullet"
];

let selected = styles[0];

function avatarUrl(top) {
    return `${BASE}?seed=${seed}&top=${top}`;
}

// Set initial preview
const previewImg = document.getElementById('previewImg');
previewImg.src = avatarUrl(selected);

// Build grid
const grid = document.getElementById('grid');
styles.forEach(style => {
    const card = document.createElement('div');
    card.className = 'av-card' + (style === selected ? ' active' : '');

    const img = document.createElement('img');
    img.src = avatarUrl(style);
    img.alt = style;

    card.appendChild(img);
    card.addEventListener('click', () => {
        selected = style;
        previewImg.src = avatarUrl(style);
        grid.querySelectorAll('.av-card').forEach(c => c.classList.remove('active'));
        card.classList.add('active');
    });

    grid.appendChild(card);
});

// Save
document.getElementById('saveBtn').addEventListener('click', () => {
    const btn = document.getElementById('saveBtn');
    btn.disabled = true;
    btn.textContent = 'Saving...';

    fetch(SAVE, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ seed, style: 'avataaars', top: selected })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            previewImg.src = data.avatar + '?t=' + Date.now();
            alert('Avatar saved!');
        } else {
            alert('Error: ' + data.error);
        }
    })
    .catch(() => alert('Request failed.'))
    .finally(() => {
        btn.disabled = false;
        btn.textContent = 'Save Avatar';
    });
});
</script>
{% endblock %}
